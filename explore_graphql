#!/usr/bin/env ruby

# Credit Karma GraphQL API Explorer
#
# This script helps discover available GraphQL operations by:
# 1. Extracting operation names and types from captured JSON responses
# 2. Attempting introspection queries (often disabled in production)
# 3. Making arbitrary GraphQL queries for exploration
#
# Usage:
#   # Analyze captured JSON files for operations
#   ruby explore_graphql --analyze
#
#   # Try introspection (requires MY_ACCESS_TOKEN env var)
#   ruby explore_graphql --introspect
#
#   # Make a custom query
#   ruby explore_graphql --query "query { prime { ... } }"
#
#   # List known operations
#   ruby explore_graphql --list

