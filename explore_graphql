when '--introspect', '-i'
  try_introspection
when '--probe', '-p'
  probe_operations
when '--list', '-l'
  list_known
when '--query', '-q'
  if ARGV[1]
    custom_query(ARGV[1])
  else
    puts "Usage: ruby explore_graphql --query \"query { ... }\""
  end
when '--help', '-h', nil
